# ============================================================
#  SEC EDGAR
#  BẮT BUỘC: SEC chặn (403) mọi request không khai báo danh tính.
#  Điền tên + email thật của bạn, đây là yêu cầu trong Fair Access Policy của họ.
# ============================================================
SEC_USER_AGENT="Tu Boylang boylangtu20144@gmail.com"

# ============================================================
#  LLM - LM Studio expose một API tương thích chuẩn OpenAI
#  Bật server: LM Studio -> tab Developer -> Start Server
# ============================================================
LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=lm-studio                  # LM Studio không kiểm tra key, để gì cũng được

# Model TRÍCH XUẤT: chạy hàng nghìn lần, chỉ cần xuất JSON đúng schema.
# Ưu tiên model 12-14B nằm trọn trong 16GB VRAM để đạt tốc độ cao.
LLM_EXTRACTION_MODEL=google/gemma-3-12b

# Model SUY LUẬN: chạy vài lần mỗi câu hỏi, cần thông minh. Model 24B của bạn ở đây.
LLM_REASONING_MODEL=google/gemma-3-27b

LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=300                        # giây - model local chạy chậm, để rộng tay

# Model có bước suy nghĩ (Gemma 4, Qwen3, DeepSeek-R1) sinh token vào một luồng riêng.
# Đo thật với Gemma 4 26B: 506 token suy nghĩ chỉ để sinh ra 12 token nội dung.
#   none     tắt hẳn — dùng cho việc máy móc như trích xuất JSON theo schema
#   default  giữ nguyên hành vi model — dùng khi cần suy luận thật
LLM_REASONING_EFFORT=none

# ============================================================
#  Embedding - dùng fastembed (ONNX, chạy CPU) để KHÔNG tranh VRAM với LLM
# ============================================================
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# ============================================================
#  Cơ sở dữ liệu
# ============================================================
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=fintech123
NEO4J_DATABASE=neo4j

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=sec_filings

# ============================================================
#  Phạm vi dữ liệu
# ============================================================
TARGET_TICKERS=AAPL,MSFT,NVDA,GOOGL
FILING_TYPES=10-K
FILINGS_PER_COMPANY=2                  # lấy 2 báo cáo năm gần nhất mỗi công ty
